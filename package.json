{
  "name": "portifolio",
  "version": "1.1.0",
  "description": "Personal portfolio of Lucas Nunes de Assis — a static site (jQuery + Bootstrap 4 + Owl Carousel).",
  "private": true,
  "scripts": {
    "dev": "live-server --port=8080 --entry-file=index.html",
    "start": "live-server --port=8080",
    "format": "prettier --write \"**/*.{html,css,js,mjs,json,md}\"",
    "format:check": "prettier --check \"**/*.{html,css,js,mjs,json,md}\"",
    "lint:html": "htmlhint index.html index-pt-br.html curriculo.html",
    "check:links": "node scripts/check-links.mjs"
  },
  "keywords": [
    "portfolio",
    "static-site",
    "bootstrap",
    "owl-carousel"
  ],
  "author": "Lucas Nunes de Assis <lucas.nunes.de.assis@gmail.com>",
  "license": "MIT",
  "devDependencies": {
    "htmlhint": "^1.1.4",
    "live-server": "^1.2.2",
    "prettier": "^3.3.3"
  }
}
